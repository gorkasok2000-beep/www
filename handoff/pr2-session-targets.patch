 =?UTF-8?q?=D0=BE=D0=BA=D0=BE=D0=BB=D0=B5=D0=BD=D0=B8=D1=8F=20targets=20se?=
 =?UTF-8?q?ssion=20key:=20=D1=81=D1=82=D0=B0=D1=80=D1=8B=D0=B5=20=D1=81?=
 =?UTF-8?q?=D0=BF=D0=B8=D1=81=D0=BA=D0=B8=20=D0=BD=D0=B5=20=D0=B4=D0=B5?=
 =?UTF-8?q?=D0=B9=D1=81=D1=82=D0=B2=D1=83=D1=8E=D1=82=20=D0=BF=D0=BE=D1=81?=
 =?UTF-8?q?=D0=BB=D0=B5=20=D0=BF=D0=B5=D1=80=D0=B5=D0=B2=D1=8B=D0=BF=D1=83?=
 =?UTF-8?q?=D1=81=D0=BA=D0=B0/=D0=BE=D1=82=D0=B7=D1=8B=D0=B2=D0=B0=20(H2)?=
