{
  "name": "synth-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Synth Wallet — ERC-4337 wallet prototype for AI agents as economic actors",
  "license": "MIT",
  "scripts": {
    "chain": "anvil",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:fmt": "forge fmt --root contracts",
    "deploy:local": "forge script script/Deploy.s.sol:Deploy --root contracts --rpc-url http://127.0.0.1:8545 --broadcast",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "db:push": "pnpm --filter web db:push",
    "demo": "pnpm --filter web exec tsx ../../examples/agent-demo.ts",
    "e2e": "node scripts/e2e.mjs",
    "check-env": "node scripts/check-env.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "reindex": "node scripts/reindex.mjs",
    "db:migrate": "pnpm --filter web db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "viem": "^2.55.10"
  }
}
