{
  "name": "synth-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Synth Wallet — ERC-4337 wallet prototype for AI agents as economic actors",
  "license": "MIT",
  "scripts": {
    "chain": "anvil",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "contracts:fmt": "forge fmt --root contracts",
    "deploy:local": "forge script script/Deploy.s.sol:Deploy --root contracts --rpc-url http://127.0.0.1:8545 --broadcast",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
