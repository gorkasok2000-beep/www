# ---------------------------------------------------------------------------
# Контракты (Foundry)
# ---------------------------------------------------------------------------

# Ключ деплойера. Значение ниже — первый аккаунт anvil, он публичен и годится
# ТОЛЬКО для локальной сети.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Владелец реестра (право заморозки). По умолчанию — адрес деплойера.
# ADMIN=

# Адрес EntryPoint. Пусто = канонический v0.9 (0x4337...D009) в тестовых сетях;
# локально скрипт сам поднимет копию из референсного пакета.
# ENTRYPOINT=

# RPC тестовых сетей — понадобятся только при деплое за пределы anvil.
# BASE_SEPOLIA_RPC_URL=
# ARBITRUM_SEPOLIA_RPC_URL=

# ---------------------------------------------------------------------------
# Веб-приложение (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Сеть, с которой работает приложение. 31337 = локальный anvil.
NEXT_PUBLIC_CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Ключ, которым сервер шифрует приватные ключи агентов (32 байта в hex).
# Сгенерировать: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# Ключ EOA, который отправляет UserOperation в EntryPoint на локальной сети
# (роль бандлера). В тестовой сети вместо него используется BUNDLER_URL.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# URL внешнего бандлера (Pimlico/Alchemy). Если задан — используется он,
# иначе операции отправляются напрямую через EntryPoint.handleOps.
# BUNDLER_URL=

# Токен админ-эндпоинта заморозки.
ADMIN_API_TOKEN=change-me

# База данных прототипа.
DATABASE_URL=file:./synth-wallet.db

# Тестовый кран и выдача газа владельцам ключей. На публичной сети ОБЯЗАТЕЛЬНО
# false: регистрация открыта, и с включённым краном кошелёк оператора сольют.
# FAUCET_ENABLED=true
