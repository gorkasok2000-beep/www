// Хранилище прототипа. Ончейн остаётся источником истины по балансам, правилам и
// транзакциям; база держит только то, чего в блокчейне нет: API-ключи, ключи подписи
// и кэш событий для витрины.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id String @id @default(cuid())

  /// Публичное имя агента на витрине. Дублирует onchain-handle из AgentRegistry.
  handle String @unique

  /// HUMAN_CUSTODIAN | AUTONOMOUS_ENTITY (SQLite не поддерживает enum).
  mode String

  /// Адрес ERC-4337 кошелька.
  accountAddress String @unique

  /// Соль CREATE2, из которой посчитан адрес. Выводится из handle, хранится ради
  /// воспроизводимости: по ней адрес пересчитывается без обращения к сети.
  salt String @default("0")

  /// EOA, которым агент подписывает UserOperation.
  ownerAddress String

  /// Чем платформа подписывает операции агента: SERVER_KEY | SESSION_KEY | REMOTE.
  /// См. `src/lib/chain/signer.ts` — там же описано, что каждый режим означает.
  signerMode String @default("SERVER_KEY")

  /// Приватный ключ агента, зашифрованный AES-256-GCM на APP_ENCRYPTION_KEY.
  /// Заполнен только в режиме SERVER_KEY — прототипном. В остальных режимах главный
  /// ключ у агента, и у платформы его нет: это и есть цель перехода.
  ownerKeyCiphertext String?

  /// REMOTE: эндпоинт агента, который возвращает подпись по хешу операции.
  signerUrl String?

  /// Кастодиан-человек (null для Autonomous Entity) и его ключ — по той же схеме.
  custodianAddress       String?
  custodianKeyCiphertext String?

  /// sha256 от выданного API-ключа. Сам ключ показывается один раз при регистрации.
  apiKeyHash String @unique

  createdAt DateTime @default(now())

  transactions    TransactionLog[]
  sessionKeys     SessionKey[]
  payments        Payment[]
  issuedInvoices  Invoice[]       @relation("IssuedInvoices")
  faucetGrants    FaucetGrant[]
}

/// Платёж как объект с идентификатором и состоянием, а не как факт «запрос вернул 201».
///
/// Агент ретраит по своему усмотрению и человека в цикле нет, поэтому повтор запроса
/// не должен превращаться во вторую трату. Ключ идемпотентности вместе с хешом тела
/// пишется ДО отправки операции: пока записи нет, платёж не начат; как только она есть,
/// повтор с тем же ключом вернёт её, а не отправит вторую операцию.
model Payment {
  id String @id @default(cuid())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Значение заголовка Idempotency-Key. Уникален в пределах агента.
  idempotencyKey String

  /// sha256 канонизированного тела запроса. Отличает честный повтор от нового
  /// запроса, которому по ошибке достался уже использованный ключ.
  requestHash String

  to       String
  valueWei String
  data     String @default("0x")

  /// CREATED — запись есть, в сеть ничего не ушло. Дольше нескольких минут в этом
  /// статусе бывает только след упавшего процесса: гасится в FAILED (см. payments.ts).
  /// SUBMITTED — операция подписана и отправлена, известен userOpHash.
  /// CONFIRMED — найден UserOperationEvent с success = true.
  /// FAILED — отвергнута на валидации либо исполнение не удалось.
  status String @default("CREATED")

  /// Известен ДО отправки: операция уже собрана и подписана. Благодаря этому
  /// «повисший» платёж можно найти в логах EntryPoint, даже не зная txHash.
  userOpHash    String?
  txHash        String?

  /// Блок, в котором операция исполнилась. Пока он не ушёл на глубину подтверждений,
  /// платёж считается неподтверждённым: реорг может вытеснить этот блок вместе с
  /// транзакцией бандлера.
  blockNumber String?

  failureReason String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, idempotencyKey])
  @@index([agentId, status])
}

/// Счёт: платёж, инициированный получателем.
///
/// Агент видит сумму, адрес и назначение, решает, платить ли, и платит по идентификатору
/// счёта. Идемпотентность здесь получается бесплатно: у счёта одна оплата, повторный
/// запрос возвращает первый результат.
model Invoice {
  id String @id @default(cuid())

  /// Кто выставил. Оплатить счёт можно, не зная выставившего, поэтому связь необязательна.
  issuerAgentId String?
  issuer        Agent?  @relation("IssuedInvoices", fields: [issuerAgentId], references: [id], onDelete: SetNull)

  /// Адрес получателя средств.
  to       String
  valueWei String
  memo     String?

  /// OPEN — ждёт оплаты. PAYING — захвачен конкретным платежом (оплата идёт).
  /// PAID — оплачен. EXPIRED — истёк срок. CANCELLED — отменён выставившим.
  status    String   @default("OPEN")
  expiresAt DateTime

  payments Payment[]

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([issuerAgentId, status])
}

/// Ключ ограниченного доступа, выданный платформе владельцем кошелька.
///
/// Приватная часть лежит здесь, зашифрованная тем же ключом окружения, что и всё
/// остальное, — но цена её утечки принципиально другая: контракт не даст потратить
/// больше `budgetWei`, позже `validUntil` и не тем получателям. Границы проверяет
/// блокчейн, а не эта таблица; поля дублируют их только для отображения.
model SessionKey {
  id String @id @default(cuid())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Адрес ключа. Он же — то, что записано в контракте кошелька.
  address String @unique

  /// Приватная часть, AES-256-GCM на APP_ENCRYPTION_KEY.
  privateKeyCiphertext String

  budgetWei  String
  validUntil DateTime

  /// JSON-массив разрешённых получателей; пустой — ограничения по адресам нет.
  targets String @default("[]")

  /// PENDING — ключ выпущен, но владелец ещё не зарегистрировал его в контракте.
  /// ACTIVE — регистрация подтверждена чтением контракта.
  /// REVOKED — отозван.
  status String @default("PENDING")

  createdAt   DateTime  @default(now())
  activatedAt DateTime?
  revokedAt   DateTime?

  @@index([agentId, status])
}

/// Кэш событий AgentTransaction. Нужен, чтобы дашборд и витрина не переспрашивали
/// ноду на каждый рендер; при расхождении онchain-лог всегда главнее.
model TransactionLog {
  id String @id @default(cuid())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  accountAddress String
  to             String
  valueWei       String
  selector       String
  txHash         String
  blockNumber    String
  timestamp      DateTime

  /// Уникальность события в блокчейне: хеш транзакции + индекс лога.
  logIndex Int

  @@unique([txHash, logIndex])
  @@index([accountAddress])
  @@index([timestamp])
}

/// Курсор индексатора: с какого блока продолжать чтение логов.
model IndexerState {
  id              String @id @default("default")
  lastBlockNumber String
}

/// Разовая выдача тестового крана.
///
/// Нужна для суточного лимита на агента: регистрация открыта, и без учёта выдач
/// кран сливал бы кошелёк оператора по максимуму за запрос, просто чаще.
model FaucetGrant {
  id String @id @default(cuid())

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  valueWei  String
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}
